PORT=8787
HOST=127.0.0.1
CACHE_TTL_SECONDS=600
TRANSPORT_CACHE_TTL_SECONDS=300
RAILWAY_RESULT_LIMIT=8

# Set to true after `npm run login:ctrip` has created a local browser profile.
CTRIP_SCRAPER_ENABLED=false
CTRIP_HEADLESS=true
CTRIP_PROFILE_DIR=.data/ctrip-profile

# Enables the Ctrip flight list crawler with the same persistent browser session.
# Falls back to CTRIP_SCRAPER_ENABLED when not set.
CTRIP_FLIGHT_SCRAPER_ENABLED=false

# Set to true after `npm run login:tongcheng` has created a local browser profile.
TONGCHENG_SCRAPER_ENABLED=false
TONGCHENG_HEADLESS=true
TONGCHENG_PROFILE_DIR=.data/tongcheng-profile

# eLong Open Platform credentials issued by the platform/business team. The
# production host also requires this server's public IP on the allowlist.
ELONG_USER=
ELONG_APP_KEY=
ELONG_SECRET_KEY=
ELONG_ENDPOINT=https://api.elong.com/rest
ELONG_VERSION=1.70
ELONG_BOOKING_BASE_URL=https://m.elong.com/hotel/detail

# OneBound Ctrip catalog endpoint. The API key/secret are issued by OneBound;
# the catalog only supplies reference prices, not live inventory.
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
ONEBOUND_CTRIP_ENDPOINT=https://api-gw.onebound.cn/xiecheng/item_search_hotel/
ONEBOUND_CACHE=yes

# Optional when Playwright's bundled Chromium is unavailable. Prefer a locally
# installed stable browser, for example channel=chrome, or provide an absolute path.
PLAYWRIGHT_CHANNEL=
PLAYWRIGHT_EXECUTABLE_PATH=

# Free developer key from RollingGo/Dida. Keep this on the server only.
ROLLINGGO_API_KEY=
ROLLINGGO_ENDPOINT=https://mcp.rollinggo.cn/mcp

# Managed travel assistant. Keep the real key in Backend/.env only.
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_MODEL=glm-5.3-flash

# AMap Web Service key. An iOS SDK key cannot be used by this server adapter.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
