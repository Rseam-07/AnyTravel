PORT=8787
HOST=127.0.0.1
CACHE_TTL_SECONDS=600
TRANSPORT_CACHE_TTL_SECONDS=300
RAILWAY_RESULT_LIMIT=8

# Set to true after `npm run login:ctrip` has created a local browser profile.
CTRIP_SCRAPER_ENABLED=false
CTRIP_HEADLESS=true
CTRIP_PROFILE_DIR=.data/ctrip-profile

# Free developer key from RollingGo/Dida. Keep this on the server only.
ROLLINGGO_API_KEY=
ROLLINGGO_ENDPOINT=https://mcp.rollinggo.cn/mcp
